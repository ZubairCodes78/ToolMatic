{
  "headers": [
    {
      "source": "/(.*.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*.webp|.*.png|.*.jpg|.*.jpeg|.*.svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.toolmatic.site"
        }
      ],
      "destination": "https://toolmatic.site/",
      "statusCode": 301
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.toolmatic.site"
        }
      ],
      "destination": "https://toolmatic.site/$1",
      "statusCode": 301
    },
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/index.php",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/(.*)/index.html",
      "destination": "/$1/",
      "statusCode": 301
    },
    {
      "source": "/(.*)/index.php",
      "destination": "/$1/",
      "statusCode": 301
    },
    {
      "source": "/tools/:path*",
      "destination": "/image-compressor/",
      "statusCode": 301
    },
    {
      "source": "/id/penghitung-kata",
      "destination": "/id/kompres-gambar/",
      "statusCode": 301
    },
    {
      "source": "/id/generator-meta-tag",
      "destination": "/id/kompres-gambar/",
      "statusCode": 301
    },
    {
      "source": "/id/cek-kepadatan-kata-kunci",
      "destination": "/id/kompres-gambar/",
      "statusCode": 301
    },
    {
      "source": "/id/kalkulator-bmi",
      "destination": "/id/kompres-gambar/",
      "statusCode": 301
    },
    {
      "source": "/id/kalkulator-persentase",
      "destination": "/id/kompres-gambar/",
      "statusCode": 301
    },
    {
      "source": "/id/kalkulator-umur",
      "destination": "/id/kompres-gambar/",
      "statusCode": 301
    },
    {
      "source": "/id/cek-kemiripan-teks",
      "destination": "/id/kompres-gambar/",
      "statusCode": 301
    },
    {
      "source": "/id/gambar-ke-teks",
      "destination": "/id/kompres-gambar/",
      "statusCode": 301
    },
    {
      "source": "/id/pdf-ke-word",
      "destination": "/id/kompres-gambar/",
      "statusCode": 301
    },
    {
      "source": "/id/pembuat-cv",
      "destination": "/id/kompres-gambar/",
      "statusCode": 301
    },
    {
      "source": "/pages/:path*",
      "destination": "/",
      "statusCode": 301
    }
  ]
}