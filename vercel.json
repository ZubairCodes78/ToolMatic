{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*.webp|.*.png|.*.jpg|.*.jpeg|.*.svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/tools/:path*",
      "destination": "/image-compressor/",
      "permanent": true
    },
    {
      "source": "/id/penghitung-kata",
      "destination": "/id/kompres-gambar/",
      "permanent": true
    },
    {
      "source": "/id/generator-meta-tag",
      "destination": "/id/kompres-gambar/",
      "permanent": true
    },
    {
      "source": "/id/cek-kepadatan-kata-kunci",
      "destination": "/id/kompres-gambar/",
      "permanent": true
    },
    {
      "source": "/id/kalkulator-bmi",
      "destination": "/id/kompres-gambar/",
      "permanent": true
    },
    {
      "source": "/id/kalkulator-persentase",
      "destination": "/id/kompres-gambar/",
      "permanent": true
    },
    {
      "source": "/id/kalkulator-umur",
      "destination": "/id/kompres-gambar/",
      "permanent": true
    },
    {
      "source": "/id/cek-kemiripan-teks",
      "destination": "/id/kompres-gambar/",
      "permanent": true
    },
    {
      "source": "/id/gambar-ke-teks",
      "destination": "/id/kompres-gambar/",
      "permanent": true
    },
    {
      "source": "/id/pdf-ke-word",
      "destination": "/id/kompres-gambar/",
      "permanent": true
    },
    {
      "source": "/id/pembuat-cv",
      "destination": "/id/kompres-gambar/",
      "permanent": true
    },
    {
      "source": "/pages/:path*",
      "destination": "/",
      "permanent": true
    }
  ]
}